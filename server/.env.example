# Copy to server/.env and replace placeholders locally. Never commit real values.
# PostgreSQL must already contain the named database before db:migrate.
# URL-encode special characters in credentials; retain provider-required SSL options.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fixit?schema=public

# Required: generate a private random secret using the PowerShell steps in README.md.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# The Vite development proxy targets port 5000.
PORT=5000
# Exact frontend origin, without a trailing slash; also used for checkout returns.
CLIENT_URL=http://localhost:5173

# Optional: leave blank for setup without hosted checkout.
# Only PayMongo test secrets (sk_test_ prefix) are accepted; never use live keys.
# Enter the real test secret only in server/.env, then restart Express.
PAYMONGO_SECRET_KEY=

# Password-reset email. Put actual secrets only in server/.env.
# Use a private SMTP sandbox (e.g. Mailpit bound to localhost) for development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FixIT <no-reply@example.invalid>
# Only for a local development SMTP sandbox without STARTTLS. Ignored in production.
SMTP_ALLOW_INSECURE=false
# NODE_ENV=production requires HTTPS CLIENT_URL and encrypted SMTP.
# Optional separate, migrated PostgreSQL database for reset integration tests:
TEST_DATABASE_URL=
